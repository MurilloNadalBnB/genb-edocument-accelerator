{
	"_version": "1.60.0",
	"sap.app": {
		"id": "bnb.edoc",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": ["", "pt", "es", "fr", "de"],
			"fallbackLocale": ""
		},
		"title": "GENB Accelerator",
		"description": "Mapping Workbench (mock)",
		"applicationVersion": {"version": "0.1.0"},
		"crossNavigation": {
			"inbounds": {
				"manage": {
					"semanticObject": "EDocumentMapping",
					"action": "manage",
					"title": "Mapping Workbench",
					"subTitle": "GENB Accelerator",
					"icon": "sap-icon://chain-link",
					"signature": {"parameters": {}, "additionalParameters": "allowed"}
				}
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"deviceTypes": {"desktop": true, "tablet": true, "phone": true}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "bnb.edoc.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.148.0",
			"libs": {
				"sap.m": {},
				"sap.f": {},
				"sap.tnt": {},
				"sap.ui.layout": {},
				"sap.ui.table": {},
				"sap.ui.codeeditor": {}
			}
		},
		"contentDensities": {"compact": true, "cozy": true},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "bnb.edoc.i18n.i18n",
					"supportedLocales": ["", "pt", "es", "fr", "de"],
					"fallbackLocale": "",
					"async": true
				}
			}
		},
		"resources": {
			"css": [{"uri": "css/style.css"}]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "bnb.edoc.view",
				"controlId": "pages",
				"controlAggregation": "pages",
				"transition": "show"
			},
			"routes": [
				{"name": "home", "pattern": "", "target": "home"},
				{"name": "country", "pattern": "country/{code}", "target": "country"},
				{"name": "workspace", "pattern": "country/{code}/{doc}", "target": "workspace"}
			],
			"targets": {
				"home": {"id": "home", "name": "Home"},
				"country": {"id": "country", "name": "Country"},
				"workspace": {"id": "workspace", "name": "Workspace"}
			}
		}
	}
}
