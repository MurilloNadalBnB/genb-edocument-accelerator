<mvc:View
	controllerName="bnb.edoc.controller.Workspace"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout"
	xmlns:t="sap.ui.table"
	xmlns:rm="sap.ui.table.rowmodes"
	xmlns:ce="sap.ui.codeeditor"
	core:require="{formatMessage: 'sap/base/strings/formatMessage'}"
	height="100%">
	<f:DynamicPage id="wsPage" fitContent="true" showFooter="true" headerExpanded="true">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{ws>/docLabel}">
						<Link text="{i18n>nav.overview}" press=".onHome"/>
						<Link text="{ws>/countryName}" press=".onCountry"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<HBox alignItems="Center">
						<Avatar initials="{ws>/code}" displayShape="Square" displaySize="S" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
						<Title text="{ws>/docLabel}" wrapping="true"/>
					</HBox>
				</f:heading>
				<f:expandedContent>
					<Text text="{ws>/sub}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{ws>/sub}"/>
				</f:snappedContent>
				<f:actions>
					<Button text="{i18n>ws.askAi}" icon="sap-icon://ai" press=".onAskAi" tooltip="{i18n>ws.askAiTooltip}"/>
				</f:actions>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="true">
				<HBox wrap="Wrap" alignItems="Start">
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.fieldsFilled}"/>
						<HBox alignItems="Baseline">
							<ObjectNumber number="{ws>/stats/filled}" unit="{parts: ['i18n>ws.ofPct', 'ws>/stats/total', 'ws>/stats/pct'], formatter: 'formatMessage'}" class="sapMObjectNumberLarge"/>
						</HBox>
						<ProgressIndicator percentValue="{ws>/stats/pct}" displayValue="{ws>/stats/pct}%" showValue="false" state="None" width="12rem"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.checks}"/>
						<ObjectNumber number="{ws>/stats/checks}" class="sapMObjectNumberLarge"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.rules}"/>
						<ObjectNumber number="{ws>/stats/rules}" class="sapMObjectNumberLarge"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.edocType}"/>
						<Text text="{ws>/edoc}"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.direction}"/>
						<ObjectStatus text="{ws>/dirText}" icon="{= ${ws>/isInbound} ? 'sap-icon://inbox' : 'sap-icon://outbox' }" state="Information"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.sourceType}"/>
						<Text text="{ws>/sourceType}"/>
					</VBox>
					<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
						<Label text="{i18n>ws.sapSource}"/>
						<Text text="{ws>/source}"/>
					</VBox>
				</HBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<IconTabBar
				id="tabs"
				selectedKey="{ws>/tab}"
				select=".onTab"
				expandable="false"
				stretchContentHeight="true"
				applyContentPadding="true"
				headerMode="Inline"
				headerBackgroundDesign="Transparent"
				backgroundDesign="Transparent">
				<items>
					<!-- ================= Field Mapping ================= -->
					<IconTabFilter key="mapping" text="{i18n>ws.tabMapping}" count="{= ${ws>/stats/rules} || '' }">
						<l:Splitter height="100%" width="100%">
							<!-- XML tree -->
							<VBox height="100%" renderType="Bare">
								<layoutData><l:SplitterLayoutData size="58%" minSize="420"/></layoutData>
								<OverflowToolbar style="Clear">
									<Title text="{i18n>ws.xmlStructure}" level="H4"/>
									<Label text="{ws>/treeSub}"/>
									<ToolbarSpacer/>
									<Button icon="sap-icon://expand-group" type="Transparent" tooltip="{i18n>ws.expandAll}" press=".onExpandAll"/>
									<Button icon="sap-icon://collapse-group" type="Transparent" tooltip="{i18n>ws.collapseAll}" press=".onCollapseAll"/>
								</OverflowToolbar>
								<Toolbar style="Clear">
									<SearchField value="{ws>/search}" liveChange=".onTreeSearch" placeholder="{i18n>ws.searchTree}">
										<layoutData><ToolbarLayoutData shrinkable="true" minWidth="10rem"/></layoutData>
									</SearchField>
									<SegmentedButton selectedKey="{ws>/filter}" selectionChange=".onFilter">
										<items>
											<SegmentedButtonItem key="all" text="{i18n>ws.filterAll}"/>
											<SegmentedButtonItem key="mapped" text="{i18n>ws.filterMapped}"/>
											<SegmentedButtonItem key="open" text="{i18n>ws.filterOpen}"/>
										</items>
									</SegmentedButton>
								</Toolbar>
								<t:TreeTable
									id="tree"
									rows="{path: 'ws>/tree', parameters: {arrayNames: ['children']}}"
									selectionMode="Single"
									selectionBehavior="RowOnly"
									rowSelectionChange=".onRowSelect"
									columnHeaderVisible="true"
									enableColumnReordering="false"
									noData="{i18n>ws.noFields}">
									<t:layoutData><FlexItemData growFactor="1" minHeight="0"/></t:layoutData>
									<t:rowMode><rm:Auto minRowCount="6"/></t:rowMode>
									<t:columns>
										<t:Column width="40%" minWidth="220">
											<Label text="{i18n>ws.colElement}"/>
											<t:template>
												<HBox alignItems="Center" renderType="Bare">
													<core:Icon src="{ws>icon}" color="{ws>iconColor}" class="sapUiTinyMarginEnd"/>
													<Label text="{ws>prefix}" visible="{= !!${ws>prefix} }" wrapping="false"/>
													<Text text="{ws>local}" wrapping="false" visible="{= !!${ws>leaf} }"/>
													<Title text="{ws>local}" wrapping="false" visible="{= !${ws>leaf} }" titleStyle="H6"/>
													<ObjectStatus text="{ws>listText}" visible="{= !!${ws>listText} }" icon="sap-icon://list" state="Indication06" class="sapUiTinyMarginBegin" tooltip="{i18n>ws.repeatingTooltip}"/>
												</HBox>
											</t:template>
										</t:Column>
										<t:Column width="22%">
											<Label text="{i18n>ws.sampleValue}"/>
											<t:template>
												<Text text="{ws>value}" wrapping="false"/>
											</t:template>
										</t:Column>
										<t:Column width="16%">
											<Label text="{i18n>ws.sapSource}"/>
											<t:template>
												<ObjectStatus text="{ws>source}" state="Information"/>
											</t:template>
										</t:Column>
										<t:Column>
											<Label text="{i18n>ws.rules}"/>
											<t:template>
												<HBox alignItems="Center" renderType="Bare" wrap="NoWrap">
													<Label text="{ws>countText}" visible="{= !${ws>leaf} }" class="sapUiTinyMarginEnd"/>
													<HBox items="{path: 'ws>pills', templateShareable: false}" renderType="Bare">
														<ObjectStatus text="{ws>text}" state="{ws>state}" inverted="true" class="sapUiTinyMarginEnd"/>
													</HBox>
												</HBox>
											</t:template>
										</t:Column>
										<t:Column width="3.5rem" hAlign="Center">
											<t:template>
												<Button icon="sap-icon://add" type="Transparent" tooltip="{i18n>ws.addRule}" visible="{= !!${ws>leaf} }" press=".onAddRuleRow"/>
											</t:template>
										</t:Column>
									</t:columns>
								</t:TreeTable>
							</VBox>

							<!-- Side panel -->
							<ScrollContainer height="100%" vertical="true" horizontal="false">
								<layoutData><l:SplitterLayoutData size="auto" minSize="360"/></layoutData>
								<VBox class="sapUiSmallMargin">
									<!-- nothing selected -->
									<MessageStrip visible="{= ${ws>/sel/kind} === 'none' }" type="Information" showIcon="true"
										text="{i18n>ws.selectHint}"/>

									<!-- group or leaf -->
									<Panel visible="{= ${ws>/sel/kind} !== 'none' }">
										<HBox alignItems="Center">
											<Avatar src="{= ${ws>/sel/kind} === 'group' ? 'sap-icon://folder-blank' : ${ws>/sel/isAttr} ? 'sap-icon://tag' : 'sap-icon://form' }"
												displayShape="Square" displaySize="S"
												backgroundColor="{= ${ws>/sel/kind} === 'group' ? 'Accent1' : 'Accent6' }" class="sapUiSmallMarginEnd"/>
											<VBox>
												<Title text="{ws>/sel/name}" level="H3" wrapping="true"/>
												<Label text="{ws>/sel/path}" wrapping="true"/>
											</VBox>
										</HBox>
										<HBox wrap="Wrap" class="sapUiSmallMarginTop">
											<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom" visible="{= ${ws>/sel/kind} === 'leaf' }">
												<Label text="{i18n>ws.sampleValue}"/>
												<Text text="{= ${ws>/sel/value} || ${i18n>common.empty} }"/>
											</VBox>
											<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
												<Label text="{i18n>ws.kind}"/>
												<Text text="{ws>/sel/kindText}"/>
											</VBox>
											<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom" visible="{= ${ws>/sel/kind} === 'group' }">
												<Label text="{i18n>ws.fieldsInside}"/>
												<Text text="{ws>/sel/total}"/>
											</VBox>
											<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
												<Label text="{= ${ws>/sel/kind} === 'group' ? ${i18n>ws.filterMapped} : ${i18n>ws.rules} }"/>
												<Text text="{ws>/sel/ruleCount}"/>
											</VBox>
										</HBox>
										<MessageStrip visible="{= ${ws>/sel/kind} === 'group' }" type="Information" showIcon="true" class="sapUiSmallMarginTop"
											text="{i18n>ws.groupHint}"/>

										<VBox visible="{= ${ws>/sel/kind} === 'leaf' }">
											<HBox wrap="Wrap" alignItems="Center" visible="{= ${ws>/sel/suggestions}.length > 0 }" class="sapUiSmallMarginTop">
												<core:Icon src="sap-icon://lightbulb" color="Default" class="sapUiTinyMarginEnd"/>
												<Label text="{i18n>ws.suggested}" class="sapUiTinyMarginEnd"/>
												<HBox items="{ws>/sel/suggestions}" wrap="Wrap" renderType="Bare">
													<Button text="{ws>f}" tooltip="{ws>desc}" press=".onQuickMap" class="sapUiTinyMarginEnd"/>
												</HBox>
											</HBox>
											<HBox wrap="Wrap" class="sapUiSmallMarginTop">
												<Button text="{i18n>rule.typeMap}" icon="sap-icon://journey-arrive" type="Emphasized" press=".onOpenDlg" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
													<customData><core:CustomData key="type" value="map"/></customData>
												</Button>
												<Button text="{i18n>ws.addCheck}" icon="sap-icon://shield" press=".onOpenDlg" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
													<customData><core:CustomData key="type" value="check"/></customData>
												</Button>
												<Button text="{i18n>rule.typeChange}" icon="sap-icon://switch-views" press=".onOpenDlg" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
													<customData><core:CustomData key="type" value="change"/></customData>
												</Button>
												<Button text="{i18n>rule.typeConstant}" icon="sap-icon://pushpin-off" type="Transparent" press=".onOpenDlg" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
													<customData><core:CustomData key="type" value="constant"/></customData>
												</Button>
												<Button text="{i18n>ws.askAi}" icon="sap-icon://ai" type="Transparent" press=".onAskAi" tooltip="{i18n>ws.askAiFieldTooltip}" class="sapUiTinyMarginBottom"/>
											</HBox>
											<List items="{ws>/sel/rules}" visible="{= ${ws>/sel/rules}.length > 0 }" showSeparators="Inner" class="sapUiTinyMarginTop">
												<CustomListItem>
													<HBox alignItems="Center" class="sapUiTinyMargin">
														<ObjectStatus text="{ws>short}" icon="{ws>icon}" state="{ws>state}" inverted="true" class="sapUiSmallMarginEnd"/>
														<VBox width="100%">
															<layoutData><FlexItemData growFactor="1"/></layoutData>
															<ObjectStatus text="{ws>source}" visible="{= !!${ws>source} }" state="Information"/>
															<Text text="{ws>desc}"/>
														</VBox>
														<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>common.edit}" press=".onEditRule"/>
														<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.delete}" press=".onDeleteRule"/>
													</HBox>
												</CustomListItem>
											</List>
										</VBox>
									</Panel>

									<!-- All rules -->
									<OverflowToolbar style="Clear" class="sapUiSmallMarginTop">
										<Title text="{ws>/allRulesTitle}" level="H4"/>
										<ToolbarSpacer/>
										<Button text="{i18n>ws.clearAll}" icon="sap-icon://delete" type="Transparent" visible="{= ${ws>/allRules}.length > 0 }" press=".onClearRules"/>
									</OverflowToolbar>
									<IllustratedMessage
										visible="{= ${ws>/allRules}.length === 0 }"
										illustrationType="sapIllus-NoEntries"
										illustrationSize="Spot"
										title="{i18n>ws.noRulesTitle}"
										description="{i18n>ws.noRulesText}"/>
									<!-- contextualWidth: the columns pop in below the field when the side panel is narrow (small laptop screens) -->
									<Table
										items="{ws>/allRules}"
										visible="{= ${ws>/allRules}.length > 0 }"
										sticky="ColumnHeaders"
										contextualWidth="Auto"
										popinLayout="GridSmall">
										<columns>
											<Column><Text text="{i18n>ws.colField}"/></Column>
											<Column width="22%" minScreenWidth="30rem" demandPopin="true"><Text text="{i18n>ws.colRule}"/></Column>
											<Column minScreenWidth="30rem" demandPopin="true"><Text text="{i18n>ws.colDetails}"/></Column>
											<Column width="5.5rem" hAlign="End"/>
										</columns>
										<items>
											<ColumnListItem type="Active" press=".onRuleRowPress" highlight="{= ${ws>selected} ? 'Information' : 'None' }">
												<cells>
													<ObjectIdentifier title="{ws>field}" text="{ws>shortPath}" tooltip="{ws>path}"/>
													<HBox wrap="Wrap" renderType="Bare">
														<ObjectStatus text="{ws>short}" state="{ws>state}" inverted="true" class="sapUiTinyMarginEnd"/>
														<ObjectStatus text="auto" visible="{ws>auto}" state="Indication10" inverted="true"/>
													</HBox>
													<VBox>
														<ObjectStatus text="{= ${ws>source} || '-' }" state="{= ${ws>source} ? 'Information' : 'None' }"/>
														<Label text="{ws>desc}" wrapping="true"/>
													</VBox>
													<HBox justifyContent="End" renderType="Bare">
														<Button icon="sap-icon://edit" type="Transparent" tooltip="{i18n>common.edit}" press=".onEditRule"/>
														<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.delete}" press=".onDeleteRule"/>
													</HBox>
												</cells>
											</ColumnListItem>
										</items>
									</Table>
								</VBox>
							</ScrollContainer>
						</l:Splitter>
					</IconTabFilter>

					<!-- ================= XML Preview ================= -->
					<IconTabFilter key="xml" text="{i18n>ws.tabXml}">
						<VBox height="100%" renderType="Bare">
							<OverflowToolbar style="Clear">
								<Title text="{i18n>ws.tabXml}" level="H4"/>
								<Label text="{i18n>ws.xmlHint}"/>
							</OverflowToolbar>
							<ScrollContainer vertical="true" horizontal="true" height="100%">
								<layoutData><FlexItemData growFactor="1" minHeight="0"/></layoutData>
								<core:HTML id="xmlHtml" content="{ws>/xmlHtml}" sanitizeContent="false" preferDOM="false"/>
							</ScrollContainer>
						</VBox>
					</IconTabFilter>

					<!-- ================= Code Preview ================= -->
					<IconTabFilter key="code" text="{i18n>ws.tabCode}">
						<VBox height="100%" renderType="Bare">
							<OverflowToolbar style="Clear">
								<Title text="{i18n>ws.abapPreview}" level="H4"/>
								<Select selectedKey="{ws>/objKey}" items="{ws>/objects}" change=".onObject" width="16rem" tooltip="{i18n>ws.objectsTooltip}">
									<core:ListItem key="{ws>key}" text="{ws>text}" additionalText="{ws>badi}"/>
								</Select>
								<ObjectStatus text="{ws>/fromText}" state="{= ${ws>/obj/generated} ? 'Indication05' : 'Indication04' }" inverted="true"/>
								<ObjectStatus text="{parts: ['i18n>ws.reviewedBy', 'ws>/reviewText'], formatter: 'formatMessage'}" icon="sap-icon://ai" state="Indication07" inverted="true" visible="{= !!${ws>/reviewText} &amp;&amp; !!${ws>/obj/generated} }"/>
								<ObjectStatus text="Mock" state="Indication10" inverted="true">
									<layoutData><OverflowToolbarLayoutData priority="Low"/></layoutData>
								</ObjectStatus>
								<ToolbarSpacer/>
								<Button text="{i18n>ws.copy}" icon="sap-icon://copy" visible="{= !!${ws>/abap} }" press=".onCopyCode" tooltip="{i18n>ws.copyTooltip}"/>
								<Button text="{i18n>impl.request}" icon="sap-icon://collaborate" type="Emphasized" press=".onRequestImpl">
									<layoutData><OverflowToolbarLayoutData priority="NeverOverflow"/></layoutData>
								</Button>
							</OverflowToolbar>
							<IllustratedMessage
								visible="{= !${ws>/abap} }"
								illustrationType="sapIllus-NoData"
								title="{i18n>ws.nothingTitle}"
								description="{i18n>ws.nothingText}"/>
							<ce:CodeEditor
								id="codeEditor"
								visible="{= !!${ws>/abap} }"
								type="abap"
								editable="false"
								value="{ws>/abap}"
								height="100%"
								lineNumbers="true">
								<ce:layoutData><FlexItemData growFactor="1" minHeight="0"/></ce:layoutData>
							</ce:CodeEditor>
						</VBox>
					</IconTabFilter>
				</items>
			</IconTabBar>
		</f:content>
		<f:footer>
			<OverflowToolbar>
				<ObjectStatus
					text="{= ${ws>/savedAt} ? ${i18n>ws.draftSaved} + ' ' + ${ws>/savedAt} : ${i18n>ws.draftNotSaved} }"
					state="{= ${ws>/savedAt} ? 'Success' : 'Warning' }"
					icon="{= ${ws>/savedAt} ? 'sap-icon://sys-enter-2' : 'sap-icon://edit' }"/>
				<Text text="{ws>/countsText}" class="sapUiSmallMarginBegin"/>
				<ToolbarSpacer/>
				<Button text="{i18n>ws.saveDraft}" press=".onSave"/>
				<Button text="{i18n>impl.request}" icon="sap-icon://collaborate" press=".onRequestImpl" tooltip="{i18n>impl.requestTooltip}"/>
				<Button text="{i18n>gen.title}" type="Emphasized" icon="sap-icon://syntax" press=".onGenerate"/>
			</OverflowToolbar>
		</f:footer>
	</f:DynamicPage>
</mvc:View>
