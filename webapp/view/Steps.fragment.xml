<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- 3-step progress, step 2 active: Country > Document type > Field mapping -->
	<HBox alignItems="Center" wrap="Wrap" class="sapUiSmallMarginTop">
		<ObjectStatus text="1. Country" icon="sap-icon://sys-enter-2" state="Success" class="sapUiSmallMarginEnd"/>
		<core:Icon src="sap-icon://slim-arrow-right" class="sapUiSmallMarginEnd"/>
		<ObjectStatus text="2. Scenario" icon="sap-icon://edit" state="Information" active="false" inverted="true" class="sapUiSmallMarginEnd"/>
		<core:Icon src="sap-icon://slim-arrow-right" class="sapUiSmallMarginEnd"/>
		<ObjectStatus text="3. Field mapping" icon="sap-icon://circle-task" state="None"/>
	</HBox>
</core:FragmentDefinition>
