<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- 3-step progress indicator, step 2 active: Country > Document type > Field mapping -->
	<HBox class="edocSteps" alignItems="Center" wrap="Wrap">
		<HBox alignItems="Center" class="edocStep edocStepDone">
			<core:Icon src="sap-icon://accept" class="edocStepDot"/>
			<Text text="Country"/>
		</HBox>
		<HBox class="edocStepLine edocStepLineDone"/>
		<HBox alignItems="Center" class="edocStep edocStepCurrent">
			<Text text="2" class="edocStepDot"/>
			<Text text="Document type"/>
		</HBox>
		<HBox class="edocStepLine"/>
		<HBox alignItems="Center" class="edocStep">
			<Text text="3" class="edocStepDot"/>
			<Text text="Field mapping"/>
		</HBox>
	</HBox>
</core:FragmentDefinition>
