<mvc:View
	controllerName="bnb.edoc.controller.Country"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:core="sap.ui.core"
	height="100%">
	<f:DynamicPage id="countryPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:breadcrumbs>
					<Breadcrumbs currentLocationText="{c>/name}">
						<Link text="Overview" press=".onHome"/>
					</Breadcrumbs>
				</f:breadcrumbs>
				<f:heading>
					<HBox alignItems="Center">
						<Avatar initials="{c>/code}" displayShape="Square" displaySize="S" backgroundColor="Accent6" class="sapUiSmallMarginEnd"/>
						<Title text="{c>/name}" wrapping="true"/>
					</HBox>
				</f:heading>
				<f:expandedContent>
					<Text text="{c>/scenario}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{c>/scenario}"/>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox>
					<HBox wrap="Wrap">
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<Label text="Scenarios"/>
							<Text text="{= ${c>/docs}.length }"/>
						</VBox>
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<Label text="XML formats"/>
							<Text text="{c>/formats}"/>
						</VBox>
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<Label text="eDocument types"/>
							<Text text="{c>/edocs}"/>
						</VBox>
						<VBox class="sapUiLargeMarginEnd sapUiTinyMarginBottom">
							<Label text="Status"/>
							<ObjectStatus text="Available" state="Success" icon="sap-icon://sys-enter-2"/>
						</VBox>
					</HBox>
					<core:Fragment fragmentName="bnb.edoc.view.Steps" type="XML"/>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiResponsiveContentPadding">
				<Title text="Choose a scenario" level="H3" class="sapUiSmallMarginBottom"/>
				<FlexBox wrap="Wrap" items="{c>/docs}">
					<GenericTile
						header="{c>label}"
						subheader="{c>desc}"
						frameType="TwoByOne"
						press=".onDoc"
						class="sapUiSmallMarginEnd sapUiSmallMarginBottom">
						<TileContent footer="{c>dirText} · {c>source}">
							<NumericContent value="{= String(${c>rules}) }" scale="{= ${c>rules} === 1 ? 'rule' : 'rules' }" icon="{c>icon}" valueColor="{= ${c>rules} ? 'Good' : 'Neutral' }" withMargin="false"/>
						</TileContent>
					</GenericTile>
				</FlexBox>
				<MessageStrip
					class="sapUiSmallMarginTop"
					type="Information"
					showIcon="true"
					text="Every scenario starts from a real XML of a live project, anonymized. Outbound scenarios map SAP data to the XML; inbound scenarios map the received XML to the SAP document to post. The field picker and the suggestions follow the SAP source (SD, MM or FI)."/>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
