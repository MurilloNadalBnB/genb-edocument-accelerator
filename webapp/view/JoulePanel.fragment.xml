<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Joule side panel: the customer's Joule (agents, knowledge bases) plus the GENB DRC knowledge -->
	<ResponsivePopover
		id="joulePanel"
		placement="Bottom"
		contentWidth="30rem"
		contentHeight="38rem"
		verticalScrolling="false"
		class="edocJoule">
		<customHeader>
			<Bar>
				<contentLeft>
					<Avatar src="sap-icon://da-2" displaySize="XS" backgroundColor="Accent7" class="sapUiTinyMarginBegin"/>
					<Title text="Joule" level="H5" class="sapUiTinyMarginBegin"/>
					<Label text="· your Joule + GENB DRC knowledge"/>
				</contentLeft>
				<contentRight>
					<Button icon="sap-icon://refresh" type="Transparent" tooltip="New conversation" press=".onJouleReset"/>
					<Button icon="sap-icon://decline" type="Transparent" tooltip="Close" press=".onJouleClose"/>
				</contentRight>
			</Bar>
		</customHeader>
		<content>
			<VBox height="100%" renderType="Bare">
				<!-- Connected knowledge -->
				<VBox class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
					<HBox alignItems="Center">
						<ObjectStatus text="Connected to {app>/joule/tenant}" icon="sap-icon://connected" state="Success"/>
					</HBox>
					<HBox wrap="Wrap" class="sapUiTinyMarginTop">
						<ObjectStatus text="{= ${app>/joule/agents}.length } of your agents" icon="sap-icon://robot" state="Indication05" inverted="true" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
						<ObjectStatus text="{= ${app>/joule/knowledge}.length } of your knowledge bases" icon="sap-icon://course-book" state="Indication05" inverted="true" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
						<ObjectStatus text="{app>/joule/bnb/name}" icon="sap-icon://official-service" state="Indication04" inverted="true" class="sapUiTinyMarginBottom"/>
					</HBox>
				</VBox>

				<!-- Conversation -->
				<ScrollContainer id="jouleScroll" vertical="true" height="100%" class="sapUiTinyMarginTop">
					<layoutData><FlexItemData growFactor="1" minHeight="0"/></layoutData>
					<VBox class="sapUiSmallMarginBeginEnd">
						<IllustratedMessage
							visible="{= ${app>/joule/messages}.length === 0 }"
							illustrationType="sapIllus-SimpleConnection"
							illustrationSize="Spot"
							title="Ask about your eDocuments"
							description="Joule answers with your own agents and knowledge bases, and adds what B&amp;B learned in live DRC projects."/>
						<VBox items="{app>/joule/messages}" renderType="Bare">
							<VBox renderType="Bare">
								<VBox visible="{= ${app>from} === 'user' }" class="edocJouleMsg edocJouleUser" renderType="Bare">
									<Text text="{app>text}"/>
								</VBox>
								<VBox visible="{= ${app>from} !== 'user' }" class="edocJouleMsg edocJouleBot" renderType="Bare">
									<FormattedText htmlText="{app>html}"/>
									<HBox items="{path: 'app>sources', templateShareable: false}" wrap="Wrap" class="sapUiTinyMarginTop" renderType="Bare">
										<ObjectStatus
											text="{app>text}"
											icon="{= ${app>kind} === 'agent' ? 'sap-icon://robot' : ${app>kind} === 'kb' ? 'sap-icon://course-book' : 'sap-icon://official-service' }"
											state="{= ${app>kind} === 'bnb' ? 'Indication04' : 'Indication05' }"
											class="sapUiTinyMarginEnd"/>
									</HBox>
								</VBox>
							</VBox>
						</VBox>
						<BusyIndicator visible="{app>/joule/busy}" size="1.5rem" text="Joule is checking your agents and knowledge bases" class="sapUiSmallMarginTop"/>
					</VBox>
				</ScrollContainer>

				<!-- Prompt suggestions and input -->
				<HBox items="{app>/joule/prompts}" wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTop" renderType="Bare">
					<Button text="{app>text}" press=".onJoulePrompt" class="sapUiTinyMarginEnd sapUiTinyMarginBottom"/>
				</HBox>
				<FeedInput post=".onJoulePost" placeholder="Message Joule" showIcon="false" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom"/>
			</VBox>
		</content>
	</ResponsivePopover>
</core:FragmentDefinition>
