<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:l="sap.ui.layout">
	<Dialog
		id="ruleDialog"
		title="{dlg>/title}"
		icon="sap-icon://source-code"
		contentWidth="68rem"
		contentHeight="38rem"
		resizable="true"
		draggable="true"
		verticalScrolling="false"
		horizontalScrolling="false"
		class="edocDialog">
		<subHeader>
			<OverflowToolbar style="Clear">
				<Label text="{dlg>/path}" wrapping="false"/>
			</OverflowToolbar>
		</subHeader>
		<content>
			<l:Splitter height="100%" width="100%">
				<!-- SAP source catalog -->
				<VBox height="100%" renderType="Bare">
					<layoutData><l:SplitterLayoutData size="24rem" minSize="280"/></layoutData>
					<HBox alignItems="Center" class="sapUiSmallMarginBeginEnd sapUiSmallMarginTop">
						<core:Icon src="sap-icon://table-view" class="sapUiTinyMarginEnd"/>
						<Title text="{dlg>/catalogTitle}" level="H5"/>
						<Label text="· {dlg>/sourceLabel}" class="sapUiTinyMarginBegin" wrapping="false"/>
					</HBox>
					<VBox class="sapUiSmallMarginBeginEnd sapUiTinyMarginTop">
						<SearchField value="{dlg>/q}" liveChange=".onDlgSearch" placeholder="{i18n>rule.searchCatalog}"/>
					</VBox>
					<VBox visible="{= ${dlg>/suggestions}.length > 0 &amp;&amp; ${dlg>/type} !== 'constant' }" class="sapUiSmallMarginBeginEnd sapUiTinyMarginTop">
						<Label text="{i18n>rule.suggestedForField}"/>
						<HBox items="{dlg>/suggestions}" wrap="Wrap" renderType="Bare">
							<ToggleButton text="{dlg>f}" tooltip="{dlg>desc}" icon="sap-icon://lightbulb" pressed="{dlg>selected}" press=".onDlgPickSuggestion" class="sapUiTinyMarginEnd sapUiTinyMarginTop"/>
						</HBox>
					</VBox>
					<ScrollContainer vertical="true" height="100%" class="sapUiSmallMarginTop">
						<layoutData><FlexItemData growFactor="1" minHeight="0"/></layoutData>
						<Tree
							id="catalogTree"
							items="{path: 'dlg>/catalog', parameters: {arrayNames: ['nodes']}}"
							mode="SingleSelectMaster"
							includeItemInSelection="true"
							itemPress=".onCatalogPress"
							updateFinished=".onCatalogUpdated"
							noDataText="{i18n>rule.noSapField}">
							<CustomTreeItem type="Active">
								<HBox alignItems="Center" renderType="Bare">
									<core:Icon src="{dlg>icon}" class="sapUiTinyMarginEnd" visible="{= ${dlg>kind} !== 'field' }"/>
									<Text text="{dlg>text}" wrapping="false"/>
									<Label text="{dlg>desc}" wrapping="false" class="sapUiTinyMarginBegin"/>
									<core:Icon src="sap-icon://lightbulb" visible="{= !!${dlg>suggested} }" tooltip="{i18n>rule.suggested}" color="Default" class="sapUiTinyMarginBegin"/>
								</HBox>
							</CustomTreeItem>
						</Tree>
					</ScrollContainer>
				</VBox>

				<!-- Rule form -->
				<ScrollContainer height="100%" vertical="true" horizontal="false">
					<layoutData><l:SplitterLayoutData size="auto" minSize="380"/></layoutData>
					<VBox class="sapUiSmallMargin">
						<Label text="{i18n>rule.what}" design="Bold"/>
						<SegmentedButton selectedKey="{dlg>/type}" selectionChange=".onDlgType" width="100%" class="sapUiTinyMarginTop">
							<items>
								<SegmentedButtonItem key="map" text="{i18n>rule.typeMap}" icon="sap-icon://journey-arrive"/>
								<SegmentedButtonItem key="check" text="{i18n>rule.typeCheck}" icon="sap-icon://shield"/>
								<SegmentedButtonItem key="change" text="{i18n>rule.typeChange}" icon="sap-icon://switch-views"/>
								<SegmentedButtonItem key="constant" text="{i18n>rule.typeConstant}" icon="sap-icon://pushpin-off"/>
							</items>
						</SegmentedButton>
						<Label text="{dlg>/typeHelp}" wrapping="true" class="sapUiTinyMarginTop"/>

						<Label text="{i18n>rule.xmlTarget}" class="sapUiSmallMarginTop"/>
						<Input value="&lt;{dlg>/nodeName}&gt;" description="{= ${i18n>rule.sample} + ' ' + (${dlg>/nodeValue} || ${i18n>common.empty}) }" fieldWidth="60%" editable="false"/>

						<!-- SAP source -->
						<VBox visible="{= ${dlg>/type} !== 'constant' }">
							<Label text="{= ${dlg>/type} === 'check' ? ${i18n>rule.sourceOptional} : ${i18n>rule.sourceField} }"
								required="{= ${dlg>/type} !== 'check' }" class="sapUiSmallMarginTop"/>
							<HBox alignItems="Center">
								<Input value="{dlg>/source}" description="{dlg>/sourceDesc}" fieldWidth="40%" editable="false"
									placeholder="{= ${dlg>/type} === 'check' ? ${i18n>rule.checkPlaceholder} : ${i18n>rule.pickPlaceholder} }">
									<layoutData><FlexItemData growFactor="1"/></layoutData>
								</Input>
								<Button icon="sap-icon://decline" type="Transparent" tooltip="{i18n>common.remove}" visible="{= !!${dlg>/source} }" press=".onDlgClearSource" class="sapUiTinyMarginBegin"/>
							</HBox>
						</VBox>

						<!-- Map -->
						<VBox visible="{= ${dlg>/type} === 'map' }">
							<Label text="{i18n>rule.outputFormat}" class="sapUiSmallMarginTop"/>
							<Select selectedKey="{dlg>/cfg/format}" items="{dlg>/formats}" width="100%">
								<core:Item key="{dlg>key}" text="{dlg>text}"/>
							</Select>
						</VBox>

						<!-- Check -->
						<VBox visible="{= ${dlg>/type} === 'check' }">
							<HBox>
								<VBox width="50%" class="sapUiTinyMarginEnd">
									<Label text="{i18n>rule.condition}" class="sapUiSmallMarginTop"/>
									<Select selectedKey="{dlg>/cfg/cond}" items="{dlg>/conds}" width="100%" change=".onDlgCondChange">
										<core:Item key="{dlg>key}" text="{dlg>text}"/>
									</Select>
								</VBox>
								<VBox width="50%">
									<Label text="{i18n>rule.parameter}" class="sapUiSmallMarginTop"/>
									<Input value="{dlg>/cfg/param}" placeholder="{dlg>/paramPlaceholder}" valueLiveUpdate="true" visible="{= ${dlg>/cfg/cond} !== 'notInitial' }"/>
									<Input value="{i18n>rule.notNeeded}" editable="false" visible="{= ${dlg>/cfg/cond} === 'notInitial' }"/>
								</VBox>
							</HBox>
							<Label text="{i18n>rule.whenFails}" class="sapUiSmallMarginTop"/>
							<SegmentedButton selectedKey="{dlg>/cfg/severity}" width="100%">
								<items>
									<SegmentedButtonItem key="E" text="{i18n>rule.severityError}" icon="sap-icon://error"/>
									<SegmentedButtonItem key="W" text="{i18n>rule.severityWarning}" icon="sap-icon://alert"/>
								</items>
							</SegmentedButton>
							<Label text="{i18n>rule.messageText}" class="sapUiSmallMarginTop"/>
							<Input value="{dlg>/cfg/msg}" placeholder="{i18n>rule.messagePlaceholder}" valueLiveUpdate="true"/>
						</VBox>

						<!-- Change -->
						<VBox visible="{= ${dlg>/type} === 'change' }">
							<Label text="{i18n>rule.transformation}" class="sapUiSmallMarginTop"/>
							<Select selectedKey="{dlg>/cfg/transform}" items="{dlg>/transforms}" width="100%">
								<core:Item key="{dlg>key}" text="{dlg>text}"/>
							</Select>
							<VBox visible="{= ${dlg>/cfg/transform} === 'valmap' }">
								<Label text="{i18n>rule.valueMapping}" class="sapUiSmallMarginTop"/>
								<Table items="{dlg>/cfg/valmap}">
									<columns>
										<Column><Text text="{i18n>rule.sapValue}"/></Column>
										<Column width="2.5rem" hAlign="Center"/>
										<Column><Text text="{i18n>rule.xmlValue}"/></Column>
										<Column width="3rem" hAlign="End"/>
									</columns>
									<items>
										<ColumnListItem>
											<cells>
												<Input value="{dlg>from}" placeholder="{i18n>common.eg} F2" valueLiveUpdate="true"/>
												<core:Icon src="sap-icon://arrow-right"/>
												<Input value="{dlg>to}" placeholder="{i18n>common.eg} VAT" valueLiveUpdate="true"/>
												<Button icon="sap-icon://delete" type="Transparent" tooltip="{i18n>common.remove}" press=".onVmDelete"/>
											</cells>
										</ColumnListItem>
									</items>
								</Table>
								<Button text="{i18n>rule.addValue}" icon="sap-icon://add" type="Transparent" press=".onVmAdd" class="sapUiTinyMarginTop"/>
							</VBox>
							<HBox visible="{= ${dlg>/cfg/transform} === 'concat' }">
								<VBox width="60%" class="sapUiTinyMarginEnd">
									<Label text="{i18n>rule.secondField}" class="sapUiSmallMarginTop"/>
									<Input value="{dlg>/cfg/second}" placeholder="{i18n>common.eg} ADRC-HOUSE_NUM1" valueLiveUpdate="true"/>
								</VBox>
								<VBox width="40%">
									<Label text="{i18n>rule.separator}" class="sapUiSmallMarginTop"/>
									<Input value="{dlg>/cfg/sep}" placeholder="{i18n>rule.space}" valueLiveUpdate="true"/>
								</VBox>
							</HBox>
							<VBox visible="{= ${dlg>/cfg/transform} === 'prefix' }">
								<Label text="{i18n>rule.prefix}" class="sapUiSmallMarginTop"/>
								<Input value="{dlg>/cfg/prefix}" placeholder="{i18n>common.eg} PL" valueLiveUpdate="true"/>
							</VBox>
						</VBox>

						<!-- Constant -->
						<VBox visible="{= ${dlg>/type} === 'constant' }">
							<Label text="{i18n>rule.constantValue}" required="true" class="sapUiSmallMarginTop"/>
							<Input value="{dlg>/cfg/constant}" placeholder="{i18n>rule.constantPlaceholder}" valueLiveUpdate="true"/>
						</VBox>

						<!-- Preview -->
						<Panel headerText="{i18n>rule.preview}" class="sapUiSmallMarginTop">
							<Text text="{dlg>/preview}" renderWhitespace="true" class="edocMono"/>
						</Panel>
						<MessageStrip visible="{= !!${dlg>/error} }" text="{dlg>/error}" type="Error" showIcon="true" class="sapUiSmallMarginTop"/>
					</VBox>
				</ScrollContainer>
			</l:Splitter>
		</content>
		<footer>
			<OverflowToolbar>
				<Label text="{i18n>rule.tip}"/>
				<ToolbarSpacer/>
				<Button text="{dlg>/saveText}" type="Emphasized" press=".onDlgApply"/>
				<Button text="{i18n>common.cancel}" press=".onDlgClose"/>
			</OverflowToolbar>
		</footer>
	</Dialog>
</core:FragmentDefinition>
