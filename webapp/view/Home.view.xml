<mvc:View
	controllerName="bnb.edoc.controller.Home"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
	xmlns:l="sap.ui.layout"
	xmlns:core="sap.ui.core"
	core:require="{formatMessage: 'sap/base/strings/formatMessage'}"
	height="100%">
	<f:DynamicPage id="homePage" toggleHeaderOnTitleClick="false">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="{i18n>nav.overview}" wrapping="true"/>
				</f:heading>
				<f:expandedContent>
					<Text text="{parts: ['i18n>home.welcome', 'app>/user/name'], formatter: 'formatMessage'}"/>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="{parts: ['i18n>home.welcomeShort', 'app>/user/name'], formatter: 'formatMessage'}"/>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:header>
			<f:DynamicPageHeader pinnable="false">
				<VBox>
					<Title text="{i18n>home.headline}" level="H2" titleStyle="H4" wrapping="true"/>
					<Text class="sapUiTinyMarginTop" text="{i18n>home.intro}"/>
				</VBox>
			</f:DynamicPageHeader>
		</f:header>
		<f:content>
			<VBox class="sapUiResponsiveContentPadding">
				<!-- AI: Joule, SAP Generative AI Hub and GENB AI, alone or together -->
				<f:Card class="sapUiMediumMarginBottom">
					<f:header>
						<card:Header
							title="{i18n>home.aiTitle}"
							subtitle="{i18n>home.aiSubtitle}"
							subtitleMaxLines="3"
							iconSrc="sap-icon://ai"
							iconBackgroundColor="Accent7"
							statusText="{app>/ai/activeText}"/>
					</f:header>
					<f:content>
						<VBox width="100%" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
							<l:Grid content="{app>/ai/engines}" defaultSpan="XL4 L4 M12 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiNoMarginBegin sapUiNoMarginEnd edocEngines">
								<VBox class="edocEngine">
									<HBox alignItems="Center" justifyContent="SpaceBetween">
										<!-- name and provider shrink and wrap, so the switch never leaves the box on narrow screens -->
										<HBox alignItems="Center">
											<layoutData><FlexItemData shrinkFactor="1" minWidth="0"/></layoutData>
											<Avatar src="{app>icon}" initials="{app>initials}" imageFitType="Contain" displaySize="S" displayShape="Square" backgroundColor="{app>color}" class="sapUiSmallMarginEnd">
												<layoutData><FlexItemData shrinkFactor="0"/></layoutData>
											</Avatar>
											<VBox>
												<layoutData><FlexItemData shrinkFactor="1" minWidth="0"/></layoutData>
												<Title text="{app>name}" level="H5" wrapping="true"/>
												<Label text="{app>by}" wrapping="true"/>
											</VBox>
										</HBox>
										<Switch state="{app>enabled}" change=".onEngineSwitch" tooltip="{parts: ['i18n>home.useEngine', 'app>name'], formatter: 'formatMessage'}" class="sapUiTinyMarginBegin">
											<layoutData><FlexItemData shrinkFactor="0"/></layoutData>
										</Switch>
									</HBox>
									<ObjectStatus text="{app>status}" icon="sap-icon://connected" state="{= ${app>enabled} ? 'Success' : 'None' }" class="sapUiSmallMarginTop"/>
									<Text text="{app>desc}" class="sapUiTinyMarginTop"/>
									<VBox items="{path: 'app>items', templateShareable: false}" class="sapUiTinyMarginTop">
										<ObjectStatus text="{app>text}" icon="{app>icon}" state="Indication05" class="sapUiTinyMarginTop"/>
									</VBox>
								</VBox>
							</l:Grid>
							<HBox wrap="Wrap" alignItems="Center" class="sapUiSmallMarginTop">
								<Button text="{i18n>ai.title}" icon="sap-icon://ai" type="Emphasized" press=".onAskAi" class="sapUiTinyMarginEnd"/>
								<Button text="{i18n>home.checkMasterData}" press=".onAskAi" class="sapUiTinyMarginEnd">
									<customData><core:CustomData key="prompt" value="{i18n>ai.prompt.siren}"/></customData>
								</Button>
								<Label text="{i18n>home.switchHint}"/>
							</HBox>
						</VBox>
					</f:content>
				</f:Card>

				<!-- At a glance -->
				<Title text="{i18n>home.atAGlance}" level="H3" class="sapUiSmallMarginBottom"/>
				<HBox wrap="Wrap">
					<GenericTile header="{i18n>home.tile.countries}" subheader="{i18n>home.tile.countriesSub}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onCountry">
						<customData><core:CustomData key="code" value="FR"/></customData>
						<TileContent footer="{parts: ['i18n>home.tile.morePlanned', 'home>/planned'], formatter: 'formatMessage'}">
							<NumericContent value="{home>/available}" scale="{parts: ['i18n>home.tile.of', 'home>/countries'], formatter: 'formatMessage'}" icon="sap-icon://world" withMargin="false"/>
						</TileContent>
					</GenericTile>
					<GenericTile header="{i18n>home.tile.scenarios}" subheader="{i18n>home.tile.scenariosSub}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onCountry">
						<customData><core:CustomData key="code" value="FR"/></customData>
						<TileContent footer="{i18n>home.tile.scenariosFooter}">
							<NumericContent value="{home>/scenarios}" icon="sap-icon://documents" withMargin="false"/>
						</TileContent>
					</GenericTile>
					<GenericTile header="{i18n>home.tile.rules}" subheader="{i18n>home.tile.rulesSub}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onCountry">
						<customData><core:CustomData key="code" value="FR"/></customData>
						<TileContent footer="{i18n>home.tile.rulesFooter}">
							<NumericContent value="{home>/totalRules}" icon="sap-icon://chain-link" valueColor="{= ${home>/totalRules} ? 'Good' : 'Neutral' }" withMargin="false"/>
						</TileContent>
					</GenericTile>
					<GenericTile header="{i18n>home.tile.impl}" subheader="{i18n>home.tile.implSub}" class="sapUiTinyMarginEnd sapUiTinyMarginBottom" press=".onRequests">
						<TileContent footer="{i18n>home.tile.implFooter}">
							<NumericContent value="{= String(${app>/requests}.length) }" icon="sap-icon://collaborate" valueColor="{= ${app>/requests}.length ? 'Critical' : 'Neutral' }" withMargin="false"/>
						</TileContent>
					</GenericTile>
				</HBox>

				<!-- How it works -->
				<Title text="{i18n>home.how}" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
				<l:Grid defaultSpan="XL3 L3 M6 S12" hSpacing="1" vSpacing="1" containerQuery="true" class="sapUiNoMarginBegin sapUiNoMarginEnd">
					<f:Card>
						<f:header>
							<card:Header title="{i18n>home.step1}" subtitle="{i18n>home.step1Text}" subtitleMaxLines="3" iconSrc="sap-icon://world" iconBackgroundColor="Accent6"/>
						</f:header>
					</f:Card>
					<f:Card>
						<f:header>
							<card:Header title="{i18n>home.step2}" subtitle="{i18n>home.step2Text}" subtitleMaxLines="3" iconSrc="sap-icon://document" iconBackgroundColor="Accent6"/>
						</f:header>
					</f:Card>
					<f:Card>
						<f:header>
							<card:Header title="{i18n>home.step3}" subtitle="{i18n>home.step3Text}" subtitleMaxLines="3" iconSrc="sap-icon://chain-link" iconBackgroundColor="Accent6"/>
						</f:header>
						<f:content>
							<HBox wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
								<ObjectStatus text="MAP" icon="sap-icon://journey-arrive" inverted="true" state="Indication05" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CHECK" icon="sap-icon://shield" inverted="true" state="Indication02" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CHANGE" icon="sap-icon://switch-views" inverted="true" state="Indication07" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CONST" icon="sap-icon://pushpin-off" inverted="true" state="Indication04"/>
							</HBox>
						</f:content>
					</f:Card>
					<f:Card>
						<f:header>
							<card:Header title="{i18n>home.step4}" subtitle="{i18n>home.step4Text}" subtitleMaxLines="3" iconSrc="sap-icon://collaborate" iconBackgroundColor="Accent6"/>
						</f:header>
					</f:Card>
				</l:Grid>

				<!-- Countries -->
				<Title text="{i18n>nav.countries}" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
				<HBox wrap="Wrap" items="{home>/list}">
					<GenericTile
						header="{home>name}"
						subheader="{home>short}"
						press=".onTile"
						class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
						<TileContent footer="{home>footer}">
							<NumericContent
								value="{= ${home>planned} ? '–' : String(${home>rules}) }"
								scale="{home>scale}"
								icon="{= ${home>planned} ? 'sap-icon://future' : 'sap-icon://flag' }"
								valueColor="{= ${home>planned} ? 'Neutral' : 'Good' }"
								withMargin="false"/>
						</TileContent>
					</GenericTile>
				</HBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
