<mvc:View
	controllerName="bnb.edoc.controller.Home"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns="sap.m"
	xmlns:f="sap.f"
	xmlns:card="sap.f.cards"
	xmlns:core="sap.ui.core"
	height="100%">
	<f:DynamicPage id="homePage" toggleHeaderOnTitleClick="false" class="edocPage">
		<f:title>
			<f:DynamicPageTitle>
				<f:heading>
					<Title text="Overview" wrapping="true"/>
				</f:heading>
				<f:expandedContent>
					<Text text="Welcome back, {app>/user/name}. Pick a country to continue mapping."/>
				</f:expandedContent>
				<f:snappedContent>
					<Text text="Welcome back, {app>/user/name}"/>
				</f:snappedContent>
			</f:DynamicPageTitle>
		</f:title>
		<f:content>
			<VBox class="sapUiResponsiveContentPadding">
				<!-- Hero -->
				<HBox class="edocHero" wrap="Wrap" alignItems="Center">
					<VBox class="edocHeroText">
						<Text text="B&amp;B eDocument Accelerator" class="edocEyebrow"/>
						<Title text="Map eDocument XML fields to SAP without starting from code" level="H1" titleStyle="H2" wrapping="true"/>
						<Text class="sapUiSmallMarginTop" text="Pick a country, choose the document type and click through the XML. For each field you say where the value comes from in SAP, how it must be checked and how it should be changed. The accelerator turns those choices into ABAP for the eDocument framework."/>
						<HBox class="sapUiMediumMarginTop" wrap="Wrap">
							<Button text="Start with Poland" icon="sap-icon://navigation-right-arrow" iconFirst="false" type="Emphasized" press=".onCountry" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
								<customData><core:CustomData key="code" value="PL"/></customData>
							</Button>
							<Button text="France" press=".onCountry" class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
								<customData><core:CustomData key="code" value="FR"/></customData>
							</Button>
							<Button text="Germany" press=".onCountry" class="sapUiTinyMarginBottom">
								<customData><core:CustomData key="code" value="DE"/></customData>
							</Button>
						</HBox>
					</VBox>
					<HBox class="edocHeroKpis" wrap="Wrap">
						<VBox class="edocKpiBox">
							<Label text="Countries live"/>
							<ObjectNumber number="{home>/available}" unit="of {home>/countries}" class="edocKpiNumber"/>
						</VBox>
						<VBox class="edocKpiBox">
							<Label text="Rules defined"/>
							<ObjectNumber number="{home>/totalRules}" class="edocKpiNumber"/>
						</VBox>
						<VBox class="edocKpiBox">
							<Label text="Document types"/>
							<ObjectNumber number="3" unit="per country" class="edocKpiNumber"/>
						</VBox>
					</HBox>
				</HBox>

				<!-- How it works -->
				<Title text="How it works" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
				<FlexBox wrap="Wrap" renderType="Bare" class="edocCardGrid">
					<f:Card class="edocStepCard">
						<f:header>
							<card:Header title="1. Select the country" subtitle="Each country brings its legal XML format, eDocument type and interface already configured." subtitleMaxLines="3" iconSrc="sap-icon://world" iconBackgroundColor="Accent6"/>
						</f:header>
					</f:Card>
					<f:Card class="edocStepCard">
						<f:header>
							<card:Header title="2. Choose the document type" subtitle="Invoice, Credit Note or Accounting Document. The SAP source tables change with the type (SD billing or FI)." subtitleMaxLines="3" iconSrc="sap-icon://document" iconBackgroundColor="Accent6"/>
						</f:header>
					</f:Card>
					<f:Card class="edocStepCard">
						<f:header>
							<card:Header title="3. Define rules per XML field" subtitle="Click a field, pick the SAP field and choose what to do with it." subtitleMaxLines="3" iconSrc="sap-icon://chain-link" iconBackgroundColor="Accent6"/>
						</f:header>
						<f:content>
							<HBox wrap="Wrap" class="sapUiSmallMarginBeginEnd sapUiSmallMarginBottom">
								<ObjectStatus text="MAP" icon="sap-icon://journey-arrive" inverted="true" state="Indication05" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CHECK" icon="sap-icon://shield" inverted="true" state="Indication02" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CHANGE" icon="sap-icon://switch-views" inverted="true" state="Indication07" class="sapUiTinyMarginEnd"/>
								<ObjectStatus text="CONST" icon="sap-icon://pushpin-off" inverted="true" state="Indication04"/>
							</HBox>
						</f:content>
					</f:Card>
				</FlexBox>

				<!-- Countries -->
				<Title text="Countries" level="H3" class="sapUiMediumMarginTop sapUiSmallMarginBottom"/>
				<FlexBox wrap="Wrap" items="{home>/list}">
					<GenericTile
						header="{home>name}"
						subheader="{home>short}"
						press=".onTile"
						class="sapUiTinyMarginEnd sapUiTinyMarginBottom edocTile">
						<TileContent footer="{= ${home>planned} ? 'Planned' : 'Available' }">
							<NumericContent
								value="{= ${home>planned} ? '–' : String(${home>rules}) }"
								scale="{= ${home>planned} ? '' : 'rules' }"
								icon="{= ${home>planned} ? 'sap-icon://future' : 'sap-icon://flag' }"
								valueColor="{= ${home>planned} ? 'Neutral' : 'Good' }"
								withMargin="false"/>
						</TileContent>
					</GenericTile>
				</FlexBox>
			</VBox>
		</f:content>
	</f:DynamicPage>
</mvc:View>
