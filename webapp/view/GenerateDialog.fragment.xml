<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
	<!-- Generate Code: the ABAP comes from the rules; the user picks which AI reviews it -->
	<Dialog
		id="genDialog"
		title="{i18n>gen.title}"
		icon="sap-icon://syntax"
		contentWidth="34rem">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip
					type="Information"
					showIcon="true"
					text="{i18n>gen.info}"/>
				<List
					items="{gen>/options}"
					mode="SingleSelectLeft"
					includeItemInSelection="true"
					headerText="{i18n>gen.reviewWith}"
					class="sapUiSmallMarginTop">
					<CustomListItem selected="{gen>selected}">
						<HBox alignItems="Start" class="sapUiSmallMarginTopBottom sapUiTinyMarginEnd">
							<Avatar src="{gen>icon}" initials="{gen>initials}" imageFitType="Contain" displaySize="XS" displayShape="Square" backgroundColor="{gen>color}" class="sapUiSmallMarginEnd"/>
							<VBox>
								<HBox alignItems="Center">
									<Label text="{gen>name}" design="Bold" wrapping="true"/>
									<ObjectStatus text="{i18n>gen.recommended}" state="Success" inverted="true" visible="{gen>recommended}" class="sapUiTinyMarginBegin"/>
								</HBox>
								<Text text="{gen>desc}"/>
							</VBox>
						</HBox>
					</CustomListItem>
				</List>
				<CheckBox text="{i18n>gen.remember}" selected="{gen>/remember}" class="sapUiSmallMarginTop"/>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>gen.generate}" type="Emphasized" icon="sap-icon://syntax" press=".onGenConfirm"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>common.cancel}" press=".onGenCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
