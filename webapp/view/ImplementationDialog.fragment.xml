<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core"
	xmlns:f="sap.ui.layout.form">
	<!-- Send the generated package to B&B: creates a ticket in the B&B service ERP -->
	<Dialog
		id="implDialog"
		title="{i18n>impl.request}"
		icon="sap-icon://collaborate"
		contentWidth="40rem"
		resizable="true"
		draggable="true">
		<content>
			<VBox class="sapUiSmallMargin">
				<MessageStrip
					type="Information"
					showIcon="true"
					text="{i18n>impl.info}"/>
				<f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" labelSpanL="4" labelSpanM="4" class="sapUiSmallMarginTop">
					<f:content>
						<core:Title text="{i18n>impl.package}"/>
						<Label text="{i18n>impl.scenario}"/>
						<Text text="{impl>/scenario}"/>
						<Label text="{i18n>ws.edocType}"/>
						<Text text="{impl>/edoc}"/>
						<Label text="{i18n>ws.rules}"/>
						<Text text="{impl>/ruleText}"/>
					</f:content>
				</f:SimpleForm>
				<List items="{impl>/objects}" mode="MultiSelect" includeItemInSelection="true" headerText="{i18n>impl.objects}" class="sapUiSmallMarginTop">
					<StandardListItem title="{impl>name}" description="{impl>badi}" icon="sap-icon://syntax" selected="{impl>selected}"/>
				</List>
				<f:SimpleForm editable="true" layout="ColumnLayout" columnsM="1" columnsL="1" columnsXL="1" labelSpanL="4" labelSpanM="4" class="sapUiSmallMarginTop">
					<f:content>
						<core:Title text="{i18n>impl.delivery}"/>
						<Label text="{i18n>impl.targetSystem}" required="true"/>
						<Select selectedKey="{impl>/system}" forceSelection="true">
							<core:Item key="DEV" text="{i18n>impl.sysDev}"/>
							<core:Item key="SBX" text="{i18n>impl.sysSbx}"/>
						</Select>
						<Label text="{i18n>impl.priority}"/>
						<SegmentedButton selectedKey="{impl>/priority}">
							<items>
								<SegmentedButtonItem key="normal" text="{i18n>impl.prioNormal}"/>
								<SegmentedButtonItem key="high" text="{i18n>impl.prioHigh}"/>
								<SegmentedButtonItem key="legal" text="{i18n>impl.prioLegal}"/>
							</items>
						</SegmentedButton>
						<Label text="{i18n>impl.golive}"/>
						<DatePicker value="{impl>/golive}" valueFormat="yyyy-MM-dd" displayFormat="medium"/>
						<Label text="{i18n>impl.contact}"/>
						<Input value="{impl>/contact}" type="Email"/>
						<Label text="{i18n>impl.notes}"/>
						<TextArea value="{impl>/notes}" rows="3" placeholder="{i18n>impl.notesPlaceholder}" growing="true"/>
					</f:content>
				</f:SimpleForm>
			</VBox>
		</content>
		<beginButton>
			<Button text="{i18n>impl.send}" type="Emphasized" icon="sap-icon://paper-plane" press=".onImplSend" enabled="{= !${impl>/busy} }"/>
		</beginButton>
		<endButton>
			<Button text="{i18n>common.cancel}" press=".onImplCancel"/>
		</endButton>
	</Dialog>
</core:FragmentDefinition>
